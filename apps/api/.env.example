NODE_ENV=development
PORT=2877
API_PREFIX=api/v1
API_DOCS_PATH=api/docs
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
UPLOADS_DIR=apps/api/uploads

# MySQL control plane. The imported backend expects a navfarm_master database;
# tenant databases are named tenant_<tenant_code>.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=navfarm_master

# Use a long, random value outside source control.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# At-rest encryption for sensitive columns (vendor bank details, etc.) — see encryption.service.ts.
# Use a long, random value outside source control.
ENCRYPTION_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Required by `pnpm nx db-bootstrap api`.
SYSTEM_TENANT_DATABASE=tenant_system
SYSTEM_ADMIN_NAME="NAVFarm System Administrator"
SYSTEM_ADMIN_EMAIL=admin@navfarm.local
SYSTEM_ADMIN_PASSWORD=CHANGE_ME_TO_AT_LEAST_12_CHARACTERS

# Optional — used by `pnpm nx run api:db-seed-dev-tenant` (or the combined
# `pnpm nx run api:db-setup-dev`, which also runs db-bootstrap first) to
# create a ready-to-use dev tenant/company/admins. All have defaults if unset.
DEV_TENANT_CODE=devco
DEV_TENANT_NAME="Dev Company"
DEV_COMPANY_CODE=DEVCO
DEV_COMPANY_NAME="Dev Company Pvt Ltd"
DEV_TENANT_ADMIN_NAME="Dev Tenant Admin"
DEV_TENANT_ADMIN_EMAIL=tenantadmin@devco.local
DEV_TENANT_ADMIN_PASSWORD=DevTenant@12345
DEV_COMPANY_ADMIN_NAME="Dev Company Admin"
DEV_COMPANY_ADMIN_EMAIL=admin@devco.local
DEV_COMPANY_ADMIN_PASSWORD=DevAdmin@12345

# Optional SMTP/reset-password delivery.
FRONTEND_URL=http://localhost:3001
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@navfarm.local
SMTP_FROM_NAME="NAVFarm Support"
