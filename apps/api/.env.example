NODE_ENV=development
PORT=3000

# Replace every placeholder locally. Never commit the resulting .env file.
DATABASE_URL=mysql://MYSQL_USER:MYSQL_PASSWORD@localhost:3306/navfarm
REDIS_URL=redis://localhost:6379

# Cloudflare R2 (S3-compatible API)
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://YOUR_PUBLIC_R2_DOMAIN
