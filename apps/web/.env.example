# Browser requests always use the same-origin /api/v1 boundary.
# mock (default), proxy, or hybrid. Hybrid is rejected outside development.
NAVFARM_API_MODE=mock

# Required by proxy and hybrid modes. Keep this server-only.
NAVFARM_API_UPSTREAM_URL=http://localhost:2877
NAVFARM_API_TIMEOUT_MS=15000

# Development-only, explicit method/path allowlist for hybrid 404/501 fallback.
NAVFARM_HYBRID_MOCK_ENDPOINTS=GET /demo/example

# Development/test only. Never enable in production.
NAVFARM_ENABLE_MOCK_RESET=false
