{
  "name": "api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": [
      "api"
    ],
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "api:build",
          "api:serve"
        ],
        "options": {
          "cwd": "apps/api-e2e",
          "command": "jest --config jest.config.cts --passWithNoTests"
        }
      }
    }
  }
}
